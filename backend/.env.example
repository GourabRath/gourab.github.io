DATABASE_URL=mongodb://127.0.0.1:27017/medicare?replicaSet=rs0
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5173
# Optional integrations. Without Stripe, payment-intent creation returns an error.
GEMINI_API_KEY=
STRIPE_SECRET_KEY=
# Set only for the one-time `npm run seed:superadmin` bootstrap command.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
